# =======================================================================
# FinGraph Production Environment Configuration Reference
# Rename to .env in production deployment
# =======================================================================

APP_NAME=FinGraph
APP_VERSION=1.0.0
APP_ENV=production
DEBUG=false

API_HOST=0.0.0.0
API_PORT=8000

JWT_SECRET_KEY=change_this_to_a_secure_64_byte_random_string_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

NEO5J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO5J_PASSWORD=fingraph_secret_pass
NEO5J_DATABASE=neo4j

KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC=transactions
KAFKA_GROUP_ID=fingraph-realtime-api
KAFKA_DLQ_TOPIC=transactions_dlq

FRONTEND_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000

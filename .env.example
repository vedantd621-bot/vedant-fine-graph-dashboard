# ==============================================================================
# FinGraph - Real-Time Fraud Syndicate Analytics Configuration
# ==============================================================================

# System Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# ------------------------------------------------------------------------------
# Apache Kafka Configuration
# ------------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=transactions
KAFKA_TOPIC_TRANSACTIONS=transactions
KAFKA_TOPIC_ALERTS=fraud_alerts
KAFKA_CLIENT_ID=fingraph-simulator
KAFKA_ACKS=all
KAFKA_RETRIES=5
KAFKA_RETRY_BACKOFF_MS=500
KAFKA_CONSUMER_GROUP=fingraph-stream-processor
KAFKA_AUTO_OFFSET_RESET=latest

# ------------------------------------------------------------------------------
# Neo4j Graph Database Configuration
# ------------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=fingraph_secret_pass
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT=30

# ------------------------------------------------------------------------------
# Apache Flink Configuration
# ------------------------------------------------------------------------------
FLINK_JOBMANAGER_HOST=localhost
FLINK_JOBMANAGER_PORT=8081
FLINK_PARALLELISM=2
FLINK_CHECKPOINT_INTERVAL_MS=5000

# ------------------------------------------------------------------------------
# Backend API (FastAPI) Configuration
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_SECRET_KEY=change_this_to_a_secure_random_key_in_production

# ------------------------------------------------------------------------------
# React Dashboard Configuration
# ------------------------------------------------------------------------------
REACT_APP_API_BASE_URL=http://localhost:8000/api
PORT=3000

# ------------------------------------------------------------------------------
# Alert Engine Configuration
# ------------------------------------------------------------------------------
# Mode: mock | email | slack | webhook
ALERT_MODE=mock
ALERT_RISK_THRESHOLD_HIGH=60
ALERT_RISK_THRESHOLD_CRITICAL=80
ALERT_MIN_COMMUNITY_SIZE=3
ALERT_COOLDOWN_SECONDS=300

# Optional SMTP Settings (used when ALERT_MODE=email)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=alerts@fingraph.internal
ALERT_EMAIL_TO=fraud-ops@fingraph.internal

# Optional Slack Webhook (used when ALERT_MODE=slack)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ------------------------------------------------------------------------------
# Simulator Configuration
# ------------------------------------------------------------------------------
SIMULATOR_TPS=10
SIMULATOR_NUM_ACCOUNTS=200
SIMULATOR_NUM_PEOPLE=150
SIMULATOR_NUM_BANKS=10
SIMULATOR_SUSPICIOUS_PERCENTAGE=0.20

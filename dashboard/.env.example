# FinGraph Dashboard Environment Configuration
# Production FastAPI Backend URL (Required for Vercel deployment)
# Example: https://api.fingraph.yourdomain.com
REACT_APP_API_BASE_URL=http://localhost:8000

# Optional: Dedicated WebSocket Endpoint URL
# If omitted, defaults to wss://<REACT_APP_API_BASE_URL_HOST>/api/v1/ws
# REACT_APP_WS_URL=wss://api.fingraph.yourdomain.com/api/v1/ws
